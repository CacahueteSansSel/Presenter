<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Presenter.Views"
             x:Class="Presenter.App" Name="Presenter" RequestedThemeVariant="Light">
    <Application.Resources>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#378764"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#97B5A7"/>
        <Color x:Key="SystemAccentColor">#196246</Color>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter"/>
            <Setter Property="Foreground" Value="#182820"/>
        </Style>
        <Style Selector="views|IconGlyph">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="StackPanel.toolContent">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>
        <Style Selector="Border.separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#DFE7E1"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style Selector="Border.inspectorDivider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#DFE7E1"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#577267"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E9F1EC"/>
            <Setter Property="Foreground" Value="#17432F"/>
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.active">
            <Setter Property="Background" Value="#DCEDE3"/>
            <Setter Property="Foreground" Value="#14583B"/>
        </Style>
        <Style Selector="Button.slideCard.active">
            <Setter Property="Background" Value="#E3F0E8"/>
            <Setter Property="BorderBrush" Value="#8FBBA2"/>
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCE5DF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#14593F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D7150"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontFamily" Value="avares://Presenter/Assets/Fonts#JetBrains Mono"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#577267"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Application.Styles>
</Application>
