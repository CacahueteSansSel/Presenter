<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Presenter.App" Name="Presenter" RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <StyleInclude Source="avares://Presenter/Styles/AppStyles.axaml"/>
    </Application.Styles>
</Application>
