<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Presenter.Views"
        x:Class="Presenter.Views.PresentationWindow"
        Width="960" Height="540" Background="#0B1410"
        WindowDecorations="None" WindowStartupLocation="Manual"
        ShowInTaskbar="False">
    <Grid>
        <views:SlideSurface x:Name="ProjectionSurface" IsHitTestVisible="False"/>
        <Border x:Name="ErrorPanel" IsVisible="False" Margin="24" Padding="15,11"
                Background="#AD273C" CornerRadius="7"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <TextBlock x:Name="ErrorMessage" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
