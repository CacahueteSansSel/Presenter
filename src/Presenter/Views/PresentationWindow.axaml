<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Presenter.Views"
        x:Class="Presenter.Views.PresentationWindow"
        Width="960" Height="540" Classes="projection"
        WindowDecorations="None" WindowStartupLocation="Manual"
        ShowInTaskbar="False">
    <Grid>
        <views:SlideSurface x:Name="ProjectionSurface" IsHitTestVisible="False"/>
        <Border x:Name="ErrorPanel" Classes="projectionError" IsVisible="False" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <TextBlock x:Name="ErrorMessage" Classes="projectionErrorMessage" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
