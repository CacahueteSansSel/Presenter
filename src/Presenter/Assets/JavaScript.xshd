<SyntaxDefinition name="JavaScript" extensions=".js" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#668578"/>
  <Color name="String" foreground="#945220"/>
  <Color name="Keyword" foreground="#6B42A3" fontWeight="bold"/>
  <Color name="Number" foreground="#9C4C34"/>
  <Color name="Flow" foreground="#176B4C"/>
  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" begin="/\*" end="\*/" multiline="true" />
    <Span color="String" begin="&quot;" end="&quot;">
      <RuleSet><Rule>\\.</Rule></RuleSet>
    </Span>
    <Span color="String" begin="'" end="'">
      <RuleSet><Rule>\\.</Rule></RuleSet>
    </Span>
    <Span color="String" begin="`" end="`" multiline="true">
      <RuleSet><Rule>\\.</Rule></RuleSet>
    </Span>
    <Keywords color="Keyword">
      <Word>async</Word><Word>await</Word><Word>function</Word><Word>const</Word><Word>let</Word><Word>var</Word>
      <Word>return</Word><Word>if</Word><Word>else</Word><Word>for</Word><Word>while</Word><Word>of</Word>
      <Word>try</Word><Word>catch</Word><Word>throw</Word><Word>new</Word><Word>class</Word><Word>this</Word>
      <Word>true</Word><Word>false</Word><Word>null</Word><Word>undefined</Word><Word>break</Word><Word>continue</Word>
    </Keywords>
    <Keywords color="Flow">
      <Word>part</Word><Word>fadeIn</Word><Word>fadeOut</Word><Word>beforePresent</Word><Word>afterPresent</Word>
      <Word>hide</Word><Word>show</Word><Word>text</Word><Word>move</Word><Word>rotate</Word><Word>wait</Word>
    </Keywords>
    <Rule color="Number">\b[0-9]+(?:\.[0-9]+)?\b</Rule>
  </RuleSet>
</SyntaxDefinition>
